# Copy this file to configs/env_config.yaml and fill in your own paths.

paths:
  data_root: "/your/local/path/to/data"
  mimic_cxr_jpg_root: "${paths.data_root}/mimic-cxr-jpg/2.1.0"
  split_csv: "${paths.mimic_cxr_jpg_root}/mimic-cxr-2.0.0-split.csv"
  reports_csv: "${paths.data_root}/mimic-cxr/report_processed/mimic_cxr_cleaned.csv"
  chexpert_csv: "${paths.data_root}/data/data_files/mimic-cxr-2.0.0-chexpert.csv"
  metadata_csv: "${paths.data_root}/data/data_files/mimic-cxr-2.0.0-metadata.csv"
  processed_dir: "${paths.data_root}/mimic-cxr-p10-processed"
  processed_train_csv: "${paths.processed_dir}/train.csv"
  processed_val_csv:   "${paths.processed_dir}/val.csv"
  processed_test_csv:  "${paths.processed_dir}/test.csv"
  output_dir: "/your/output/dir"
  checkpoint_dir: "/your/checkpoint/dir"
  gcs_bucket: "gs://mimic-cxr-jpg-lite"
  gcs_project: "mimic-cxr-jpg-491409"

wandb:
  entity: ""        # your wandb entity/username
  project: "meta-cxr"

java:
  home: "/usr/lib/jvm/java-8-openjdk-amd64/jre"   # adjust to your Java installation
  path: "/usr/lib/jvm/java-8-openjdk-amd64/jre/bin:"
